<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alibaba.loongsuite</groupId>
        <artifactId>loongsuite-java-parent</artifactId>
        <version>0.3.1-SNAPSHOT</version>
    </parent>

    <artifactId>loongsuite-genai-examples</artifactId>
    <packaging>pom</packaging>

    <name>LoongSuite OTel GenAI Utils - Examples</name>
    <description>GenAI manual instrumentation examples (basic REST, ASR WebSocket, ...)</description>

    <properties>
        <spring-boot.version>3.5.3</spring-boot.version>
        <openai-java.version>4.26.0</openai-java.version>
        <dashscope-sdk.version>2.22.0</dashscope-sdk.version>
        <loongsuite.publish.skip>true</loongsuite.publish.skip>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <modules>
        <module>example-common</module>
        <module>basic-example</module>
        <module>asr-example</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Align with opentelemetry-exporter-sender-okhttp (okhttp-jvm 5.x); dashscope-sdk pins okio 3.6.0 -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>3.16.4</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-jvm</artifactId>
                <version>3.16.4</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.loongsuite</groupId>
                <artifactId>example-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
